    "merge": {
      "caption": "One sweep looks at all Ready PRs at once. An agent decides merge, send back, or ask; only a script can actually merge, and only when every condition holds at the PR's head.",
      "cardSize": {
        "width": 260,
        "height": 200
      },
      "cards": [
        {
          "id": "m-snap",
          "role": "source",
          "kind": "script",
