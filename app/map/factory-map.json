    "manager": {
      "caption": "The manager keeps work items moving and brings you the decisions it should not make itself. It answers on its own when one of your written rules covers the question, like “always ask before merging a database change”. If you keep giving the same answer, add it as a rule.",
      "cardSize": {
        "width": 260,
        "height": 200
      },
      "cards": [
        {
          "id": "u-c",
          "role": "person",
          "kind": "from intake",
          "title": "Work item is unclear",
          "text": "What should it do, and how do we know it works?",
          "x": 0,
          "y": 0,
          "asks": {
            "label": "stage",
            "value": "archon-triage"
          },
          "covers": [],
          "details": {
            "when": ["Whenever the factory reaches a decision it should not make alone."],
            "what": [
              "Examples: a work item too vague to build, a merge that changes the database, a build that keeps growing in scope, a problem that may or may not deserve a work item.",
              "Each question shows the recommended answer and the other options, and you can always write your own."
            ],
            "how": [
              "Answering resumes the paused run. The answer is written back into the work item as a dated ruling."
