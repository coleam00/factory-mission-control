{
  "caption": "Work comes from three places: a product document, an issue you file, or a problem the factory found. Intake checks each item, and Split breaks a big document or bundle into smaller work items. A work order groups the items to build and ship together. Then one line: Build writes the code, Review checks it, App check tries it in the running app, Merge lands it, and Staging is where you try the whole work order. The manager watches the line and brings you the decisions.",
  "cardSize": {
    "width": 208,
    "height": 212
  },
  "cards": [
    {
      "id": "split",
      "role": "agent",
      "kind": "split",
      "title": "Split",
      "text": "Breaks a document or a bundle into work items",
      "x": 260,
      "y": 240,
      "covers": [
        {
          "workflow": "archon-backlog",
          "steps": ["read-prd", "slice", "check", "authorize", "publish"],
          "pack": "loop"
        },
        {
          "workflow": "archon-split",
          "steps": ["facts", "slice", "publish"],
          "pack": "queue"
        },
        {
          "workflow": "factory-backlog",
          "steps": ["read", "slice", "check", "publish"],
          "pack": "queue"
        }
      ],
      "details": {
        "when": [
          "When Intake routes a product document or a bundle of tasks here.",
          "You can also start it by hand on a document in the repo."
        ],
        "what": [
          "Breaks the item into work items, each a contract of its own, with Depends on links.",
          "Never files the same piece twice, even when it runs again."
        ],
        "how": [
          "One agent reads the item and lists the pieces. A script files each one and records it.",
          "Filing an issue is what starts Intake, so the pieces come back like any other work."
        ]
      }
    },
    {
      "id": "prd",
      "role": "source",
      "kind": "input",
      "title": "Product document",
      "text": "What to build and why",
      "x": 0,
      "y": 282,
      "covers": [],
      "details": {
        "when": ["When you have something bigger than one change to build."],
        "what": [
          "The intent: problem, users, what done looks like, and how you will know it worked.",
          "Lives as an issue or a file in the repo."
        ],
        "how": [
          "Filed as an issue, it goes through Intake like anything else. Intake sends it to Split.",
          "It stays open until its result is measured. Nothing else in the factory edits it."
        ]
      }
    },
    {
      "id": "mgr",
      "role": "person",
      "kind": "manager",
      "title": "Manager",
      "text": "Keeps the factory healthy and work moving. Brings you the decisions it can't make.",
      "x": 1072,
      "y": 0,
      "width": 478,
      "chips": ["waiting"],
      "covers": [
        {
          "workflow": "archon-manager",
          "steps": ["briefs", "manage"],
          "pack": "loop"
        },
        {
          "workflow": "factory-manager",
          "steps": ["manage"],
          "pack": "queue"
        }
      ],
      "details": {
        "when": ["All the time, while the factory runs. You can also talk to it directly."],
        "what": [
          "Health: finds runs that are stuck, silent or failing and reports them.",
          "Questions: answers the ones your written rules already cover, for example “dependency updates can merge without asking”.",
          "Everything else it passes to you with a recommendation."
        ],
        "how": [
          "Your rules are plain text files (triage, build, merge) in the repo.",
          "It never cancels a run and never decides what the product should be."
        ]
      }
    },
    {
      "id": "issue",
      "role": "source",
      "kind": "input",
      "title": "New issue",
      "text": "A work item you file yourself",
      "x": 0,
      "y": 542,
      "covers": [],
      "details": {
        "when": ["Whenever you or a teammate files one."],
        "what": [
          "A single work item, written with the six elements: problem, why, why now, outcome, invariants, acceptance."
        ],
        "how": [
          "Intake checks it like any other work item. A work item missing the six elements comes to you as a question."
        ]
      }
    },
    {
      "id": "disc",
      "role": "source",
      "kind": "input",
      "title": "Found by the factory",
      "text": "Problems spotted in review, app check or staging",
      "x": 0,
      "y": 802,
      "covers": [
        {
          "workflow": "archon-discoveries",
          "steps": ["facts", "decide", "outcome", "ask", "answer"],
          "pack": "queue"
        }
      ],
      "details": {
        "when": ["After review, app check or staging notices something it was not asked to fix."],
        "what": [
          "Each problem becomes a new work item, or is dropped if it is not real. Unsure ones come to you."
        ],
        "how": [
          "Small findings are batched into one cleanup work item per area. New work items go through Intake like any other."
        ]
      }
    },
    {
      "id": "intake",
      "role": "agent",
      "kind": "triage",
      "title": "Intake",
      "text": "Checks each work item is clear, picks its route and size",
      "x": 260,
      "y": 542,
      "covers": [
        {
          "workflow": "archon-loop",
          "steps": ["pick", "claim"],
          "pack": "loop"
        },
        {
          "workflow": "archon-intake",
          "steps": ["facts", "triage", "outcome"],
          "pack": "queue"
        }
      ],
      "details": {
        "when": ["On every new, edited or relabelled work item (GitHub event)."],
        "what": [
          "Decides if the work item is ready, and which route it takes: deliver, plan first, investigate, or Split when it is too big for one build."
        ],
        "how": [
          "Trust check against maintainers.json, then triage. Intake is the only step that closes work items."
        ]
      }
    },
    {
      "id": "order",
      "role": "source",
      "kind": "work order",
      "title": "Work order",
      "text": "The next group of work to build and ship together",
      "x": 552,
      "y": 542,
      "chips": ["orders"],
      "covers": [],
      "details": {
        "when": ["Before the build queue starts on the next group of work."],
        "what": [
          "A group of work items that go through the factory together, for one release, one experiment or one branch.",
          "It can hold pieces of a document, bug fixes, anything ready. It can also be one item."
        ],
        "how": [
          "You, or the manager for you, choose what goes in, so the whole backlog does not start at once.",
          "You choose where it lands: main, dev, a release branch or staging.",
          "Being built now. Until it lands, the build queue takes the next ready item on its own."
        ]
      }
    },
    {
      "id": "build",
      "role": "agent",
      "kind": "build",
      "title": "Build",
      "text": "Writes the code and opens the PR",
      "x": 812,
      "y": 542,
      "chips": ["queued"],
      "opens": "build",
      "covers": [
        {
          "workflow": "archon-loop",
          "steps": ["build", "ship", "subject"],
          "pack": "loop"
        },
        {
          "workflow": "archon-build-queue",
          "steps": [
            "facts",
            "route",
            "checkout",
            "ship",
            "answer",
            "apply",
            "ask",
            "ruling",
            "blocked",
            "revisit",
            "retriage"
          ],
          "pack": "queue"
        }
      ],
      "details": {
        "when": [
          "Whenever a triaged work item is ready, one work item per run, most urgent first."
        ],
        "what": [
          "Takes a triaged work item to a reviewed PR with green CI.",
          "Up to 2 rounds per work item. Each round can deliver up to 4 times."
        ],
        "how": [
          "Brief, then plan or investigate if needed, then deliver, then an agent decides done, another round, or ask you. It asks early when a change has grown past its size or stopped converging."
        ]
      }
    },
    {
      "id": "review",
      "role": "agent",
      "kind": "review",
      "title": "Review",
      "text": "Up to five reviewers read the change",
      "x": 1072,
      "y": 542,
      "covers": [
        {
          "workflow": "archon-loop",
          "steps": ["ship/deliver/rounds/review", "ship/deliver/rounds/rereview"],
          "screens": {
            "ship/deliver/rounds/review": {
              "workflow": "archon-deliver-block",
              "path": "rounds/review"
            },
            "ship/deliver/rounds/rereview": {
              "workflow": "archon-deliver-block",
              "path": "rounds/rereview"
            }
          },
          "pack": "loop"
        },
        {
          "workflow": "archon-build-queue",
          "steps": ["ship/deliver/rounds/review", "ship/deliver/rounds/rereview"],
          "pack": "queue",
          "screens": {
            "ship/deliver/rounds/review": {
              "workflow": "archon-deliver-block",
              "path": "rounds/review"
            },
            "ship/deliver/rounds/rereview": {
              "workflow": "archon-deliver-block",
              "path": "rounds/rereview"
            }
          }
        }
      ],
      "details": {
        "when": ["Every time Build pushes a change to the PR."],
        "what": [
          "A quick agent picks the reviewers this change earns. Up to five each read the change for one thing: how parts fit together, correctness, tests, error handling, docs.",
          "One agent combines what they found into a single comment: Ready, or a list of fixes."
        ],
        "how": ["Fixes go back to Build. Merge only trusts a Ready comment on the latest commit."]
      }
    },
    {
      "id": "app",
      "role": "test",
      "kind": "test",
      "title": "App check",
      "text": "Tries the change in the running app",
      "x": 1332,
      "y": 542,
      "chips": ["failing"],
      "covers": [
        {
          "workflow": "archon-loop",
          "steps": ["briefs", "check-app", "evidence", "handoff"],
          "pack": "loop"
        },
        {
          "workflow": "factory-app-check",
          "steps": [
            "config",
            "select",
            "pending",
            "scope",
            "policy",
            "prepare",
            "check",
            "evidence",
            "publish",
            "finalize",
            "cleanup"
          ],
          "pack": "queue"
        }
      ],
      "details": {
        "when": [
          "On every open PR with no result yet at its current commit.",
          "Depth scales with the work item's size and whether it touches the front end."
        ],
        "what": [
          "Uses the running app the way a person would and reports what it saw.",
          "Its commit status must be green before Merge will land the PR."
        ],
        "how": [
          "Tests the PR merged with the latest main, not the branch alone.",
          "Every claim must cite a file written during this check, sealed by a script.",
          "A result stands until the PR gets a new commit, so landing another PR does not undo it."
        ]
      }
    },
    {
      "id": "merge",
      "role": "agent",
      "kind": "gate",
      "title": "Merge",
      "text": "Lands only what passed",
      "x": 1624,
      "y": 542,
      "covers": [
        {
          "workflow": "archon-loop",
          "steps": ["review", "land", "release"],
          "pack": "loop"
        },
        {
          "workflow": "archon-merge-queue",
          "steps": ["facts", "sweep", "record", "retriage", "ask", "ruling"],
          "pack": "queue"
        }
      ],
      "details": {
        "when": ["When PRs are Ready, all of them in one sweep."],
        "what": [
          "Lands only what is proven, sends the rest back with a brief, asks you on borderline cases."
        ],
        "how": [
          "The agent decides; a script merges, and only if the Ready verdict, every check and the default branch are green at the PR's head."
        ]
      }
    },
    {
      "id": "deploy",
      "role": "test",
      "kind": "ship",
      "title": "Staging",
      "text": "Where the work order lands for you to try",
      "x": 1884,
      "y": 542,
      "covers": [
        {
          "workflow": "archon-loop",
          "steps": ["deploy"],
          "pack": "loop"
        },
        {
          "workflow": "factory-deploy",
          "steps": ["preflight", "deploy", "verify"],
          "pack": "queue"
        }
      ],
      "details": {
        "when": ["After a work order's last merge, on the new revision of its target."],
        "what": [
          "Puts the merged build where you can try it.",
          "You choose where a work order lands. Staging is the one we recommend."
        ],
        "how": ["Health check plus revision read-back, so a stale deploy fails loudly."]
      }
    },
