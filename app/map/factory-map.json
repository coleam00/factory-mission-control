              "steps": ["review"]
            }
          ],
          "details": {
            "what": ["Merge, send back, or ask"]
          }
        },
        {
          "id": "m-gate",
          "role": "source",
          "kind": "script · the gate",
          "title": "Merge gate",
          "text": "Ready at head, all checks green, main green",
          "x": 688,
          "y": 0,
          "lists": ["outcomes"],
          "covers": [
            {
              "pack": "loop",
              "workflow": "archon-loop",
              "steps": ["land"]
            }
          ],
          "details": {
            "what": ["Ready at head, all checks green, main green"],
            "how": [
              "It refuses a PR that is not open: already merged or closed.",
              "It refuses a draft.",
              "It refuses a PR that does not target the default branch.",
              "It refuses when the PR's head is no longer the commit the sweep decided on.",
              "It refuses a PR that is behind the default branch, unless the forge says it merges cleanly.",
              "It refuses unless a maintainer's review verdict says Ready, for exactly the PR's head.",
              "It refuses unless CI at the PR's head is green: a failing or unfinished check holds it.",
              "It refuses while the default branch's CI is red.",
              "A merge the forge accepts but that does not read back merged at that head fails the gate."
            ]
          }
        },
        {
          "id": "m-rec",
          "role": "source",
          "kind": "script",
