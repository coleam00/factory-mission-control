    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@electric-sql/pglite": "^0.5.11",
    "@tailwindcss/vite": "^4",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5",
    "tailwindcss": "^4",
    "typescript": "^7.0.2",
